   "source": [
    "try:\n",
    "    num = int(input(\"Enter a positive number: \"))\n",
    "\n",
    "    if num <= 0:\n",
    "        raise ValueError(\"Invalid input! Please enter a positive number.\")\n",
    "\n",
    "    print(\"You entered:\", num)\n",
    "\n",
    "except ValueError as e:\n",
    "    print(\"Error:\", e)\n",
    "\n",
    "\n"
   ]
